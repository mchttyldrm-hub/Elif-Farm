{
  "name": "elif-farm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute elif-farm-db --file=db/schema.sql",
    "db:seed": "wrangler d1 execute elif-farm-db --file=db/seed.sql",
    "db:init:local": "wrangler d1 execute elif-farm-db --local --file=db/schema.sql",
    "db:seed:local": "wrangler d1 execute elif-farm-db --local --file=db/seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.28.2"
  }
}
